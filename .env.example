# Root / shared env template — copy values into worker/.dev.vars (gitignored)
# or set via: npx wrangler secret put <NAME>

# Frontend (empty = Vite proxy to Worker :8787)
VITE_API_BASE_URL=

# Worker JWT (REQUIRED — never commit real values)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# Optional OAuth (wrangler secrets)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Public URLs (safe to put in wrangler.jsonc vars)
# APP_URL=http://localhost:5173
# API_URL=http://localhost:8787

# GitHub Actions / CI (set in GitHub → Settings → Secrets, not in this repo)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
