# Frontend (empty = use Vite proxy to Worker on :8787)
VITE_API_BASE_URL=

# Worker secrets — set via worker/.dev.vars locally or `wrangler secret put` in prod
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# Public URLs (also in worker/wrangler.jsonc vars)
# APP_URL=http://localhost:5173
# API_URL=http://localhost:8787
