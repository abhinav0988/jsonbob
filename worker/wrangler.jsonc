{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jsonbob-api",
  "account_id": "b3875f2c511adc2efc6107ff8e9badf2",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_URL": "https://jsonbob-web.appsphere.workers.dev",
    "API_URL": "https://jsonbob-api.appsphere.workers.dev"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLAB_ROOM",
        "class_name": "CollabRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-collab-room",
      "new_sqlite_classes": ["CollabRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jsonbob-db",
      "database_id": "64bc484c-a6a2-4eff-a06a-ac05542c08b6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "jsonbob-documents"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "0092549bf44c44edbfe261e3585022c2"
    },
    {
      "binding": "SESSIONS",
      "id": "0a9957b92e014ece85496a21de912196"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EXPIRE_QUEUE",
        "queue": "jsonbob-expire"
      },
      {
        "binding": "ANALYTICS_QUEUE",
        "queue": "jsonbob-analytics"
      }
    ],
    "consumers": [
      {
        "queue": "jsonbob-expire",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "jsonbob-analytics",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
